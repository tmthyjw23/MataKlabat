# === LLM (9router, endpoint OpenAI-compatible) ===
# Ambil API key dan nama model dari dashboard 9router (default http://localhost:20128).
# Model WAJIB mendukung input gambar (vision) dan tool/function calling (untuk agent).
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=isi_api_key_dari_dashboard_9router
LLM_MODEL=isi_nama_model_dari_9router
# === Opsional ===
LLM_MIN_INTERVAL_S=8
HEARTBEAT_S=120
PROMPT_VERSION=v2
PROCESS_FPS=2
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AUTO_SEND_ALERT=false
FIRMS_MAP_KEY=
YOLO_WEIGHTS=
