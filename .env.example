# === LLM (AI vision + AI Agent) ===
# Model WAJIB mendukung input gambar (vision) dan tool/function calling (untuk agent).
# LLM_MODEL kosong = mode detektor lokal saja.
#
# LLM_PROVIDER memilih alamat endpoint otomatis:
#   aistudio   Google AI Studio (Gemini API), key: AISTUDIO_API_KEY (https://aistudio.google.com/apikey)
#   ollama     Ollama di mesin ini (http://127.0.0.1:11434/v1), tanpa key; model lokal atau *-cloud
#   9router    9router (http://localhost:20128/v1), key: NINEROUTER_API_KEY atau LLM_API_KEY
#   openrouter OpenRouter, key: OPENROUTER_API_KEY
#   openai     OpenAI, key: OPENAI_API_KEY
#   custom     endpoint OpenAI-compatible lain: isi LLM_BASE_URL (+ LLM_API_KEY)
# Tanpa LLM_PROVIDER: perilaku lama (LLM_BASE_URL, default 9router, + LLM_API_KEY).
LLM_PROVIDER=9router
LLM_MODEL=isi_nama_model
LLM_API_KEY=isi_api_key_dari_dashboard_9router
LLM_BASE_URL=
# Key per provider (dipakai juga oleh cadangan):
AISTUDIO_API_KEY=
NINEROUTER_API_KEY=
OPENROUTER_API_KEY=
# Cadangan otomatis bila yang utama gagal (kuota habis, model dihentikan), dipisah koma,
# format provider:model. Yang gagal diistirahatkan 5 menit lalu dicoba lagi.
# Contoh: LLM_FALLBACKS=ollama:gemma4:31b-cloud, 9router:ag/gemini-3.8-flash-high
LLM_FALLBACKS=

# === Telegram (kosong = mode kering: pesan dibuat dan tampil di web, tidak dikirim) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AUTO_SEND_ALERT=true
MORNING_SUMMARY_AT=07:00
# Tautan dashboard di pesan Telegram (opsional), misal http://192.168.1.10:8000
PUBLIC_URL=

# === Opsional ===
FIRMS_MAP_KEY=
PROMPT_VERSION=v2
LLM_MIN_INTERVAL_S=8
# Batas waktu satu panggilan LLM (detik). Model vision lewat 9router butuh ±15 dtk.
LLM_TIMEOUT_S=40
HEARTBEAT_S=120
PROCESS_FPS=2
YOLO_WEIGHTS=

# === Operator dan server ===
# Password operator untuk tombol kamera aktif/nonaktif dan galeri foto di dashboard (minimal 10 karakter).
# Kosong = tombol operator tidak ada; website hanya-baca.
OPERATOR_PASSWORD=
# Daftar kamera. Di VPS pakai config/cameras.vps.yaml (tanpa webcam, semua kamera mulai nonaktif).
CAMERAS_FILE=config/cameras.yaml
# Folder foto yang bisa dipilih operator untuk Kamera Foto.
GALLERY_DIR=data/demo/bahan
# Alamat dan port website. Di VPS biarkan 127.0.0.1 (nginx yang membuka ke luar).
WEB_HOST=127.0.0.1
WEB_PORT=8000
